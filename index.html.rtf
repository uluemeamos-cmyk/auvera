<div class="toast" id="toast" role="status" hidden></div>

<script>
(function(){
  var LANGS=[['en','English'],['pcm','Pidgin'],['ur','اردو'],['bn','বাংলা'],['so','Soomaali'],['sw','Kiswahili'],['am','አማርኛ']];
  var I={
    en:{tagline:'Every payment, verified.',received:'Received this month',owed:'Owed to you',late:'Late',newSale:'New sale',speakSale:'Speak a sale',whoOwes:'Who owes me',readMoney:'Read my money',recent:'Recent sales',noSales:'No sales yet. Tap New sale to begin.',tHome:'Home',tSell:'Sell',tOwed:'Owed',tPaid:'Paid',alarm1:'1 customer needs a reminder today',alarmN:'{n} customers need a reminder today',remindThem:'Remind',speakHint:'Auvera asks. You answer.',listening:'Listening…',customer:'Customer name',phone:'WhatsApp number',amount:'Amount (R)',item:'What they bought',whenPay:'When are they paying?',payNow:'Paying now',payLater:'Pay later',due:'Due date',custLang:"Customer's language",saveSale:'Save and send invoice',errSale:'Add the customer name and an amount.',stInv:'Invoice',stChk:'Checked',stRec:'Receipt',sendInvoice:'Send invoice',sendReminder:'Send reminder',sendFirm:'Send firm reminder',sendReceipt:'Send receipt',checkPay:'Check payment',close:'Close',seeMsg:'See message',copyMsg:'Copy message',viewChain:'View on blockchain',dueToday:'Due today',dueOn:'Due {d}',daysLate1:'1 day late',daysLateN:'{n} days late',paid:'Paid',example:'Example',howPaid:'How did they pay?',txid:'Transaction ID (ask the customer)',checkChain:'Check on the blockchain',fakeWarn:'Fake proof of payment is common. Only confirm when you see the money yourself.',confirmPay:'Confirm payment',m_eft:'Bank transfer (EFT)',m_payshap:'PayShap',m_card:'Card (Yoco)',m_cash:'Cash',m_btc:'Bitcoin',m_usdt:'USDT (Tron)',c_bank:'I saw R{a} arrive in my own banking app, not just a screenshot.',c_card:'My Yoco app or card machine shows R{a} approved.',c_cash:'I counted R{a} in cash.',c_crypto:'The blockchain shows it confirmed, to my wallet, for the right amount.',h_bank:'Checked in bank app',h_card:'Approved on card machine',h_cash:'Cash counted',h_crypto:'Checked on blockchain',owedTitle:'Who owes you',owedSub:'Late customers first.',nobodyOwes:'Nobody owes you money right now.',paidTitle:'Confirmed payments',paidSub:'Every payment here was checked.',noPaid:'Payments you confirm appear here.',settings:'Settings',appLang:'App language',bizName:'Business name',bank:'Bank details for EFT',cardLink:'Card payment link (Yoco)',large:'Large text and buttons',robot:'Phone voice for words without a recording',removeEx:'Remove example sales',back:'Back',sum:'This month you received R{r}. Customers owe you R{u}.',sumLate:'{name} owes R{a}, {n} days late.',nobodyLate:'Nobody is late.',toastSaved:'Sale saved. Send the invoice.',toastConfirmed:'Payment confirmed.',toastCopied:'Message copied.',toastExRemoved:'Example sales removed.',welcome:'Welcome to Auvera',chooseLang:'Choose your language',next:'Next',obBiz:'What is your business called?',obBizHint:'Customers see this on invoices and receipts.',obPay:'How do customers pay you?',obPayHint:'Optional. Added to invoices so customers pay straight into your own bank.',obReady:"You're ready",obReadyHint:'Auvera never touches your money. It checks, records and reminds.',startFresh:'Start my first sale',tryEx:'Look around with examples',footer:'Your data stays on this phone.',noVoice:'Voice does not work in this browser.',voiceStopped:'Voice stopped. Tap to try again.',typeAmount:'Please type the amount.',payingNowW:'paying now'}
  };
  
  var state = {
    lang: 'en',
    sales: [],
    bizName: '',
    bank: '',
    cardLink: '',
    large: false
  };

  try {
    var stored = localStorage.getItem('auvera_data');
    if (stored) state = JSON.parse(stored);
  } catch(e){}

  function save() {
    try { localStorage.setItem('auvera_data', JSON.stringify(state)); } catch(e){}
    render();
  }

  function render() {
    var langData = I[state.lang] || I.en;
    document.querySelectorAll('[data-t]').forEach(function(el){
      var key = el.getAttribute('data-t');
      if (langData[key]) el.textContent = langData[key];
    });
    
    var received = 0, unpaid = 0, late = 0;
    var now = new Date().toISOString().slice(0, 10);

    state.sales.forEach(function(s) {
      if (s.paid) {
        received += parseFloat(s.amount || 0);
      } else {
        unpaid += parseFloat(s.amount || 0);
        if (s.due && s.due < now) late++;
      }
    });

    document.getElementById('mReceived').textContent = 'R' + received.toLocaleString();
    document.getElementById('mUnpaid').textContent = 'R' + unpaid.toLocaleString();
    document.getElementById('mLate').textContent = late;
    document.getElementById('bizLine').textContent = state.bizName || 'Auvera Business';
  }

  document.querySelectorAll('[data-go]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = btn.getAttribute('data-go');
      document.querySelectorAll('.panel').forEach(function(p){ p.hidden = true; });
      var activePanel = document.getElementById('p-' + target);
      if (activePanel) activePanel.hidden = false;
      document.querySelectorAll('.tabs button').forEach(function(tb){ tb.removeAttribute('aria-current'); });
      var activeTab = document.getElementById('t-' + target);
      if (activeTab) activeTab.setAttribute('aria-current', 'page');
    });
  });

  render();
})();
</script>
</body>
